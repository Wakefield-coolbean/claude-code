	"authors": [
		"wakefield-coolbean"
	],
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.totemdestroypop.TotemDestroyPopClient"
		]
	},
	"mixins": [
		"totemdestroypop.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
